# Telegram bot token — obtain from @BotFather. Copy to .env (local only).
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Cloud (Render / Railway) ──────────────────────────────────────────────────
# Port is injected by the host automatically (Render/Railway set process.env.PORT).
# You don't need to set PORT yourself.

# Webhook mode (recommended on Render):
# Set this to your app's public URL, e.g. https://saty-bot.onrender.com
# (NO trailing slash, no /webhook at the end — it is added automatically).
WEBHOOK_URL=

# Optional secret token that guards /webhook against fake requests.
# Generate one: openssl rand -hex 24
WEBHOOK_SECRET=

# Firebase Admin credentials for the cloud (instead of serviceAccountKey.json).
# Paste the ENTIRE contents of your serviceAccountKey.json as a single-line JSON string:
# {"type":"service_account","project_id":...}
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative: absolute path to a Google credentials JSON file on the host.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json