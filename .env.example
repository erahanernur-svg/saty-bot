# Telegram bot token — obtain from @BotFather. Copy to .env (local only).
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Image storage (Cloudflare R2 = primary, Telegram = backup) ────────────────
# R2 credentials for the site's image uploads. Server-side ONLY — never shipped
# to the browser. Get them from Cloudflare Dashboard → R2 → Manage R2 API Tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# S3 endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base URL routed through Cloudflare Cache, e.g. https://cdn.example.com
# (no trailing slash). Images are served to visitors via this URL.
R2_PUBLIC_URL=

# Telegram channel that receives a backup copy of every uploaded image.
# The bot must be an admin of this channel. Use the numeric channel id or
# @channelusername.
TELEGRAM_BACKUP_CHANNEL=

# ── Cloud (Render / Railway) ──────────────────────────────────────────────────
# Port is injected by the host automatically (Render/Railway set process.env.PORT).
# You don't need to set PORT yourself.

# Webhook mode (recommended on Render):
# Set this to your app's public URL, e.g. https://saty-bot.onrender.com
# (NO trailing slash, no /webhook at the end — it is added automatically).
WEBHOOK_URL=

# Explicit public URL for the absolute webhook host. If unset, the bot forces
# https://saty-bot.onrender.com so a stale WEBHOOK_URL can never hijack the bot.
# Set BOT_PUBLIC_URL to override the host (e.g. a custom domain).
# BOT_PUBLIC_URL=https://saty-bot.onrender.com

# Optional secret token that guards /webhook against fake requests.
# Generate one: openssl rand -hex 24
WEBHOOK_SECRET=

# Firebase Admin credentials for the cloud (instead of serviceAccountKey.json).
# Paste the ENTIRE contents of your serviceAccountKey.json as a single-line JSON string:
# {"type":"service_account","project_id":...}
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative: absolute path to a Google credentials JSON file on the host.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json